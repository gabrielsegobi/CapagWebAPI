[
  {
    "nome": "Liquidez Corrente (LC)",
    "formula": "{1.01} / {2.01}"
  },

  {
    "nome": "Liquidez Seca (LS)",
    "formula": "({1.01} - {1.01.03}) / {2.01}"
  },

  {
    "nome": "Margem Líquida (ML)",
    "formula": "{3} / {3.01.01.01}"
  },

  {
    "nome": "Cobertura de Juros (CJ)",
    "formula": "({3.01.01.01} + {3.01.01.01.01.98} - {3.01.01.03} + {3.01.01.05.01.23} + {3.01.01.05.01.99} - {3.01.01.07} - {3.01.01.09.01.99} + {3.01.01.11}) / ({3.01.01.09.01.08}+{3.01.01.09.01.07}+{3.01.01.05.01.15})"
  },

  {
    "nome": "Endividamento Geral (EG)",
    "formula": "({2.01} + {2.02}) / {1}"
  }
]
