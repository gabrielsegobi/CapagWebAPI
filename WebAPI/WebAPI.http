### Variables
@baseUrl = http://localhost:5174
@token =eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..qk4xvk36MUko68_dHaDmTysa6dQyqsVsaz9h06t5_iI
@tenantId = 2
@idEmpresa = 1

### ========== AUTH ==========

### Login
POST {{baseUrl}}/api/Auth/login
Content-Type: application/json

{
  "email": "analista@cliente.com",
  "senha": "hash_de_senha_segura"
}

### Refresh Token
POST {{baseUrl}}/api/Auth/refresh-token
Content-Type: application/json

{
  "token": "refresh_token_here",
  "deviceId": "device_id_here"
}

### ========== VIEWS ==========

### Get Balan?o Patrimonial
GET {{baseUrl}}/api/Views/balanco-patrimonial?IdEmpresa=1&Ano=2024&Page=1&PageSize=10
Authorization: Bearer {{token}}

### Get DRE
GET {{baseUrl}}/api/Views/dre?IdEmpresa=1&Ano=2024&Page=1&PageSize=10
Authorization: Bearer {{token}}

### ========== EMPRESAS ==========

### Get All Empresas
GET {{baseUrl}}/api/Empresas?Page=1&PageSize=10
Authorization: Bearer {{token}}

### Get Empresa by ID
GET {{baseUrl}}/api/Empresas/2
Authorization: Bearer {{token}}

### Get Empresa by CNPJ
GET {{baseUrl}}/api/Empresas?Cnpj=12345678000190
Authorization: Bearer {{token}}

### Create Empresa
POST {{baseUrl}}/api/Empresas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id_tenant": 1,
  "cnpj": "12345678000190",
  "razao_social": "Empresa Exemplo LTDA",
  "nome_fantasia": "Empresa Exemplo",
  "matriz_filial": "M",
  "id_empresa_matriz": null,
  "ativa": true,
  "cnae": "1234-5/00",
  "municipio_estado": "S?o Paulo/SP",
  "data_abertura": "2020-01-01",
  "capital_social": "100000.00",
  "segmento": "Tecnologia",
  "porte": "M?dio"
}

### Update Empresa
PUT {{baseUrl}}/api/Empresas/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id_tenant": 1,
  "cnpj": "12345678000190",
  "razao_social": "Empresa Exemplo LTDA",
  "nome_fantasia": "Empresa Exemplo Atualizada",
  "matriz_filial": "M",
  "id_empresa_matriz": null,
  "ativa": true,
  "cnae": "1234-5/00",
  "municipio_estado": "S?o Paulo/SP",
  "data_abertura": "2020-01-01",
  "capital_social": "150000.00",
  "segmento": "Tecnologia",
  "porte": "M?dio"
}

### Delete Empresa
DELETE {{baseUrl}}/api/Empresas/1
Authorization: Bearer {{token}}

### Get Demonstrativos Cont?beis
GET {{baseUrl}}/api/Empresas/demonstrativos-contabeis?idEmpresa=1&ano=true
Authorization: Bearer {{token}}
X-Tenant-Id: {{tenantId}}

### ========== DEMONSTRATIVOS (DEFIS + PGDASD) ==========

### Contas contabeis distintas (codigo + descricao)
GET {{baseUrl}}/api/demonstrativos/contas
Authorization: Bearer {{token}}
X-Tenant-Id: {{tenantId}}

### Contas contabeis distintas por empresa
GET {{baseUrl}}/api/demonstrativos/contas?id_empresa={{idEmpresa}}
Authorization: Bearer {{token}}
X-Tenant-Id: {{tenantId}}

### Anos disponiveis (merge DEFIS + PGDASD + demonstrativos gerados)
GET {{baseUrl}}/api/demonstrativos/anos-disponiveis?id_empresa={{idEmpresa}}
Authorization: Bearer {{token}}
X-Tenant-Id: {{tenantId}}

### Cadastrar demonstrativos contabeis (JSON de contas + recalculo indicadores/ICP)
POST {{baseUrl}}/api/demonstrativos/cadastrar
Authorization: Bearer {{token}}
X-Tenant-Id: {{tenantId}}
Content-Type: application/json

{
  "sobrescrever": true,
  "contas": [
  {
    "id_empresa": {{idEmpresa}},
    "dt_ini": "2024-01-01",
    "dt_ini_apur": "2024-01-01",
    "dt_fin_apur": "2024-03-31",
    "per_apur": "T01",
    "ano": 2024,
    "codigo": "3",
    "descricao": "RESULTADO L?QUIDO DO PER?ODO",
    "tipo": "S",
    "nivel": 1,
    "val_cta_ref_fin": 1504098.41,
    "ind_val_cta_ref_fin": "C",
    "tipo_trib": "Lucro Real"
    }
  ]
}

### Construir demonstrativos (transacao por ano, sobrescrever opcional)
POST {{baseUrl}}/api/demonstrativos/construir
Authorization: Bearer {{token}}
X-Tenant-Id: {{tenantId}}
Content-Type: application/json

{
  "id_empresa": {{idEmpresa}},
  "anos": [2022, 2023, 2024],
  "sobrescrever": true
}

